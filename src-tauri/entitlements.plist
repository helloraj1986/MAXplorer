<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Outbound SMB/network access. The current build is not sandboxed, but
       keeping the entitlement makes a future App Sandbox build explicit. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- The build runs with the hardened runtime (codesign flags=0x10000), whose
       library validation refuses to dlopen libraries signed by a different
       team — which is exactly what Homebrew's libmpv is. Without this, the
       native player (media_player_open) fails with "could not load
       libmpv.dylib" even though the file exists, because the app and the dylib
       have different TeamIdentifiers. Required for the embedded libmpv engine. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- mpv embeds LuaJIT, whose JIT writes and executes machine code. Under the
       hardened runtime that is forbidden and the kernel kills the process with
       SIGKILL (Code Signature Invalid / "Invalid Page") as soon as mpv starts
       one of its built-in Lua scripts (stats.lua on a background thread, seen
       in the 2026-11-21 crash report). Both keys are required: allow-jit for the
       modern W^X JIT protocol, allow-unsigned-executable-memory for the older
       mapping-based one LuaJIT may use. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
